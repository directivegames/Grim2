{
  "scripts": {
    "build": "pnpm run generate-property-metadata && pnpm exec tsx ./scripts/genesys/sync-packs-tsconfig.ts && tsc && pnpm exec tsx ./scripts/genesys/write-build-stamp.ts",
    "turbo:build": "turbo run build",
    "generate-property-metadata": "pnpm exec tsx node_modules/@gnsx/genesys.js/scripts/generate-property-metadata.ts src/game-data.ts",
    "postinstall": "pnpm exec tsx ./scripts/genesys/post-install.ts",
    "lint": "eslint . --fix --ext .ts,.tsx",
    "sync-assets": "pnpm exec tsx ./scripts/genesys/sync-project-assets-to-dist.ts",
    "rebuild": "pnpm build && pnpm sync-assets && pnpm build-project",
    "rename-glb-animation": "pnpm exec tsx ./scripts/genesys/rename-glb-animation.ts",
    "dev": "pnpm exec tsx ./scripts/genesys/dev/generate-manifest.ts && vite",
    "validate-prefabs": "pnpm exec tsx ./scripts/genesys/validate-prefabs.ts",
    "install-developer-skills": "pnpm exec tsx ./scripts/genesys/install-developer-skills.ts",
    "apply-lightmaps": "pnpm exec tsx ./tools/apply-lightmaps-cli.ts",
    "add-uv2": "pnpm exec tsx ./tools/add-uv2-to-glbs-cli.ts",
    "check-pack-isolation": "pnpm exec tsx ./scripts/genesys/check-pack-isolation.ts",
    "export-pack": "pnpm exec tsx ./scripts/genesys/export-pack.ts",
    "preinstall": "node -e \"try{const p=require('fs').readFileSync('package.json','utf8');if(p.includes('@gnsx/genesys.harness'))require('child_process').execSync('pnpm remove @gnsx/genesys.harness',{stdio:'pipe'})}catch(e){}\"",
    "compress-glb": "pnpm exec tsx ./scripts/genesys/compress-glb.ts"
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "@gnsx/genesys.js": "19.0.0-alpha.571",
    "three": "npm:@gnsx/three@0.186.24"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@modelcontextprotocol/sdk": "1.22.0",
    "@types/adm-zip": "0.5.8",
    "@types/jsdom": "21.1.7",
    "@types/node": "25.9.3",
    "@types/three": "npm:@gnsx/three-types@0.186.13",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "adm-zip": "0.5.17",
    "ajv": "8.20.0",
    "canvas": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "get-port": "7.1.0",
    "jsdom": "26.1.0",
    "nanoid": "5.1.11",
    "sharp": "0.35.5",
    "ts-morph": "26.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-mkcert": "2.1.0",
    "vite-plugin-node-polyfills": "0.28.0",
    "ws": "8.18.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "mikktspace": "1.1.1"
  },
  "name": "Grim",
  "version": "0.0.1"
}